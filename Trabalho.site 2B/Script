// Captura o formulário e o mural de pets do HTML
const petForm = document.getElementById('petForm');
const petGrid = document.getElementById('petGrid');

// Escuta o momento em que o usuário envia o formulário
petForm.addEventListener('submit', function(event) {
    event.preventDefault(); // Impede a página de recarregar

    // Pega os valores digitados pelo usuário
    const nome = document.getElementById('nome').value;
    const especie = document.getElementById('especie').value;
    const local = document.getElementById('local').value;
    const contato = document.getElementById('contato').value;
    
    // Define o emoji com base na espécie
    const emoji = especie === 'Cachorro' ? '🐶' : especie === 'Gato' ? '🐱' : '🐾';

    // Cria a estrutura HTML do novo card do pet
    const novoCard = document.createElement('div');
    novoCard.classList.add('pet-card');

    novoCard.innerHTML = `
        <div class="pet-foto">${emoji} Foto</div>
        <div class="pet-info">
            <h3>${nome} (${especie})</h3>
            <p><strong>Visto por último:</strong> ${local}</p>
            <p><strong>Data:</strong> Hoje</p>
            <p><strong>Contato:</strong> ${contato}</p>
            <span class="status">Procura-se</span>
        </div>
    `;

    // Adiciona o novo pet no topo do mural
    petGrid.insertBefore(novoCard, petGrid.firstChild);

    // Limpa os campos do formulário para o próximo cadastro
    petForm.reset();

    // Alerta de sucesso para o usuário
    alert('Pet cadastrado com sucesso no mural!');
})
